{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "mcp:dev": "bun run mcp/server.ts",
    "mcp:test": "bun test mcp",
    "mcp:typecheck": "tsc -p tsconfig.mcp.json",
    "mcp:bundle": "bun scripts/build-mcp.ts",
    "mcp:validate": "bun run mcp:typecheck && bun run mcp:bundle && claude plugin validate agent-plugins/orbit",
    "verify:fsd": "bun scripts/verify-fsd.ts",
    "release:check": "bun scripts/check-release-version.ts",
    "bundle:mac": "CI=true tauri build --bundles app,dmg",
    "bundle:mac:universal": "CI=true tauri build --bundles app,dmg --target universal-apple-darwin",
    "test": "bun test",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "sass": "^1.102.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
